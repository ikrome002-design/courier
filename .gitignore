# Laravel app-generated temporary files
/storage/app/tmp/*
/storage/app/temp/*
/storage/app/cache/*
/storage/app/backups/*
/storage/app/exports/*
/storage/app/imports/*
/storage/app/reports/*
/storage/app/generated/*
/storage/app/invoices/*
/storage/app/receipts/*
/storage/app/labels/*
/storage/app/qrcodes/*
/storage/app/barcodes/*

# Keep placeholder .gitignore files where needed
!/storage/app/.gitignore
!/storage/app/public/.gitignore
!/storage/app/private/.gitignore


# ==============================================================================
# 4. Courier by Citrus private upload areas
# ==============================================================================

# Goods photos, proof-of-delivery photos, documents, invoices, receipts,
# dispute attachments, provider documents, vehicle documents, and KYC files
# must never be committed.

/storage/app/public/uploads/*
/storage/app/public/delivery-photos/*
/storage/app/public/proof-of-delivery/*
/storage/app/public/goods-photos/*
/storage/app/public/provider-documents/*
/storage/app/public/vehicle-documents/*
/storage/app/public/kyc/*
/storage/app/public/disputes/*
/storage/app/public/invoices/*
/storage/app/public/receipts/*
/storage/app/public/avatars/*
/storage/app/public/profile-photos/*

/storage/app/private/*
/storage/app/private/uploads/*
/storage/app/private/delivery-photos/*
/storage/app/private/proof-of-delivery/*
/storage/app/private/goods-photos/*
/storage/app/private/provider-documents/*
/storage/app/private/vehicle-documents/*
/storage/app/private/kyc/*
/storage/app/private/disputes/*
/storage/app/private/invoices/*
/storage/app/private/receipts/*
/storage/app/private/exports/*
/storage/app/private/imports/*
/storage/app/private/reports/*

# Preserve intentional directory placeholders
!/storage/app/public/.gitignore
!/storage/app/private/.gitignore


