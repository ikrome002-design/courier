# ==============================================================================
# 26. Files that SHOULD remain committed
# ==============================================================================

# Do not add these to .gitignore:
#
# composer.lock
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
# Dockerfile
# docker-compose.yml
# .env.example
# .env.testing.example
# README.md
# LICENSE
# CHANGELOG.md
# database/migrations/*
# database/seeders/*
# config/*
# routes/*
# app/*
# resources/*
# tests/*
# .github/workflows/*
# ==============================================================================
