# ==============================================================================
# Courier by Citrus
# Delivery Management SaaS / Courier Operations Platform
#
# Stack:
# - Laravel / PHP 8.2+
# - Vue.js or React.js
# - TypeScript
# - Vite
# - Tailwind CSS or Bootstrap 5
# - PostgreSQL or MySQL
# - Redis queues/cache
# - S3-compatible private file storage
# - Dockerized deployment with CI/CD
#
# Security principle:
# Never commit secrets, private uploads, tenant files, payment data, map keys,
# logs, generated build artifacts, local machine config, or runtime cache.
# ==============================================================================


# ==============================================================================
# 1. Environment files and secrets
# ==============================================================================

.env
.env.*
!.env.example
!.env.testing.example
!.env.local.example
!.env.production.example
!.env.staging.example

# Laravel encrypted environment files may be committed only when intentionally used.
# Keep the decryption key out of Git.
.env.encryption.key
.env.*.key

# Composer authentication can contain private package tokens.
auth.json

# Generic secret/config files
secrets/
secret/
private/
private-keys/
credentials/
.envrc
.direnv/

*.secret
*.secrets
*.credential
*.credentials
*.token
*.tokens
*.apikey
*.api-key
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.jks

# OAuth / service account / cloud provider credentials
client_secret*.json
credentials*.json
service-account*.json
service_account*.json
google-credentials*.json
google-service-account*.json
firebase-adminsdk*.json
oauth-client*.json

# Cloud / deployment credentials
.aws/
.gcloud/
.azure/
.doctl/
.kube/
kubeconfig
terraform.tfstate
terraform.tfstate.*
.terraform/
.terraform.lock.hcl

# Payment, SMS, Maps, email provider local credential dumps
stripe*.json
paypal*.json
paystack*.json
flutterwave*.json
mpesa*.json
daraja*.json
twilio*.json
africastalking*.json
sendgrid*.json
mailgun*.json
postmark*.json
google-maps*.json
maps-api*.json


# ==============================================================================
# 2. Laravel / PHP dependencies
# ==============================================================================

/vendor/

# IMPORTANT:
# Do NOT ignore composer.lock for this SaaS application.
# composer.lock should be committed for reproducible production builds.


# ==============================================================================
